{
  "name": "pcb-exploder",
  "private": true,
  "version": "0.1.0",
  "description": "PCB 爆炸图查看器：解析 ODB++ 数据，将各层以爆炸图/平面展开形式呈现，支持网络高亮、最小间距计算，并导出 1:1 实际尺寸的矢量 PDF 图纸。",
  "author": "yunke120 <yunke1206@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dist:win7": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.yunke.pcb-exploder",
    "productName": "PCB-Exploder",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/pdf-config.json",
        "to": "pdf-config.json"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "PCB-Exploder-${version}-win7-x64.exe"
    }
  }
}
