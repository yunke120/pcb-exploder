{
  "name": "pcb-exploder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "node -e \"const f=require('fs');f.mkdirSync('public',{recursive:true});f.copyFileSync('node_modules/gerber-to-svg/dist/gerber-to-svg.min.js','public/gerber-to-svg.min.js')\"",
    "dist:win7": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "gerber-to-svg": "^4.0.4",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.8.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.yunke.pcb-exploder",
    "productName": "PCB-Exploder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "PCB-Exploder-${version}-win7-x64.exe"
    }
  }
}
